{
  "name": "hono-svelte-playground",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run build:client && bun run build:server",
    "build:client": "vite build --mode client",
    "build:server": "vite build --mode production",
    "typecheck": "tsc --noEmit",
    "start": "bun ./dist/index.js"
  },
  "dependencies": {
    "hono": "^4.13.7",
    "hono-svelte": "file:../..",
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "daisyui": "^5.7.38",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
