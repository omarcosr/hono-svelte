{
  "name": "hono-svelte",
  "version": "0.5.0",
  "description": "Server-side shell + multi-entry Svelte pages for Hono apps",
  "keywords": [
    "hono",
    "middleware",
    "ssr",
    "svelte",
    "vite",
    "zero-js"
  ],
  "homepage": "https://github.com/omarcosr/hono-svelte",
  "license": "MIT",
  "author": "omarcos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omarcosr/hono-svelte.git"
  },
  "bin": {
    "hono-svelte": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build && npm test && npx publint",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.1",
    "publint": "^0.3.24",
    "svelte": "^5.57.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "hono": "^4.13.8",
    "svelte": "^5.57.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "bun": ">=1.4",
    "node": ">=26"
  }
}
