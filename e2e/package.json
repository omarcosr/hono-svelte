{
  "name": "hono-svelte-e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "build:hono": "cd hono-app && vite build --mode client && vite build --mode server",
    "build:kit": "cd kit-app && vite build",
    "build": "npm run build:hono && npm run build:kit && npm run build:playground",
    "start:hono:node": "node hono-app/dist/server/server.mjs",
    "start:hono:bun": "bun hono-app/dist/server/server.mjs",
    "start:kit": "node kit-app/build/index.js",
    "test": "playwright test",
    "dev:hono": "cd hono-app && vite",
    "build:playground": "cd ../examples/playground && npm install --no-package-lock --no-fund --no-audit && npm run build"
  },
  "dependencies": {
    "hono": "^4.13.8",
    "hono-svelte": "file:..",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.5",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "vite": "^8.3.0",
    "@hono/vite-dev-server": "^0.26.1"
  }
}
